    {
        "id": "aefea62c73bbaec7",
        "type": "function",
        "z": "8f5b5a88b2c87553",
        "name": "Fridge Status Check",
        "func": "let temp = msg.payload.temp;\n\nif (temp > 12) {\n    msg.payload.status = \"CRITICAL\";\n    msg.payload.fan = \"ON\";\n    msg.payload.alarm = true;\n}\nelse if (temp > 8) {\n    msg.payload.status = \"WARNING\";\n    msg.payload.fan = \"ON\";\n    msg.payload.alarm = false;\n}\nelse if (temp >= 2 && temp <= 8) {\n    msg.payload.status = \"SAFE\";\n    msg.payload.fan = \"OFF\";\n    msg.payload.alarm = false;\n}\nelse {\n    msg.payload.status = \"TOO COLD\";\n    msg.payload.fan = \"OFF\";\n    msg.payload.alarm = true;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 260,
